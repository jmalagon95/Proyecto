  "enhancement": {
    "min": 0,
    "max": 15,
    "damagePerLevelPct": 4,
    "successRatePct": 100,
    "canBreak": false,
    "canDowngrade": false,
    "goldBaseByRarity": {
      "1": 100,
      "2": 180,
      "3": 320,
      "4": 550,
      "5": 900,
      "6": 1500,
      "7": 2500,
      "8": 4000
