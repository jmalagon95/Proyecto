    "goldLevelFactor": 0.28,
    "formula": "cost = round(baseByRarity * (1 + currentEnhancement * 0.28) * (1 + (weaponLevel - 1) * 0.015)); damage = rarityBaseDamage * levelMultiplier * enhancementMultiplier",
    "levelCostFactor": 0.015
  },
  "survival1Drop": {
    "weaponDropChancePerDefeatedEnemy": 0.1,
    "rarityWithinWeaponDrop": {
      "1": 0.94,
      "2": 0.05,
      "3": 0.01
    },
    "loseAllLootOnMissionFailure": true
  },
  "weaponLevel": {
    "min": 1,
    "max": 100,
    "damagePerLevelPct": 1.8,
    "formula": "levelMultiplier = 1 + (level - 1) * 0.018",
    "notes": "El nivel del arma multiplica su daño base antes del refuerzo +1..+15. El Piso 1 genera armas de nivel 1."
  }
